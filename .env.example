# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
#
# Variables prefixed with EXPO_PUBLIC_ are inlined into the JS bundle at build
# time, so ONLY put values here that are safe to ship inside the app binary.
# Firebase web config values are identifiers, not secrets; your data is
# protected by Firebase Security Rules, API-key restrictions and App Check.
# NEVER put a Firebase Admin / service-account key in this file.

# --- Firebase (Console > Project settings > General > Your apps > Web app) ---
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Google Sign-In (Google Cloud Console > APIs & Services > Credentials) ---
# "Web client (auto created by Google Service)" — used by Firebase to verify the ID token.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# iOS OAuth client ID (only needed for iOS builds).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# --- Native build config (read by app.config.ts, NOT bundled into JS) ---
# Reversed iOS client ID, e.g. com.googleusercontent.apps.xxxxxxxx
GOOGLE_IOS_URL_SCHEME=
APP_BUNDLE_ID=com.yourcompany.authapp
